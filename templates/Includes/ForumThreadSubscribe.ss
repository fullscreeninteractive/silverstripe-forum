<a href="{$Link('unsubscribe')}/{$ForumThread.ID}?SecurityID={$SecurityID}" class="forum__subscribe-link forum__subscribe-link--unsubscribe <% if $ForumThread.HasSubscribed %><% else %>forum__subscribe-link--hidden<% end_if %>" title="<%t ForumThreadSubscribe_ss.CLICKUNSUBSCRIBE "Click here to Unsubscribe to this topic" %>"><%t ForumThreadSubscribe_ss.UNSUBSCRIBE "Unsubscribe" %></a>
<a href="{$Link('subscribe')}/{$ForumThread.ID}?SecurityID={$SecurityID}" class="forum__subscribe-link forum__subscribe-link--subscribe <% if $ForumThread.HasSubscribed %>forum__subscribe-link--hidden<% end_if %>" title="<%t ForumThreadSubscribe_ss.CLICKSUBSCRIBE "Click here to subscribe to this topic" %>"><%t ForumThreadSubscribe_ss.SUBSCRIBE "Subscribe" %></a>
